<Window x:Class="FaceRecognize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Face Recognition" Height="650" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="2">
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Margin="0,0,0,8">
            <MenuItem Header="Database">
                <MenuItem Header="Cleanup orphaned records"
                          Command="{Binding CleanupDatabaseCommand}" />
                <MenuItem Header="Clear embedding cache"
                          Command="{Binding ClearCacheCommand}" />
            </MenuItem>
        </Menu>

        <!-- Progress Bar -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                    Visibility="{Binding ProgressVisible}">
            <ProgressBar Value="{Binding ProgressValue}"
                         Maximum="{Binding ProgressMaximum}"
                         Height="10" Margin="0,0,0,4" />
            <TextBlock Text="{Binding ProgressText}"
                       Foreground="Gray" FontSize="11"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Status -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" />
            <TextBlock Text="{Binding AlignmentStatus}" Foreground="Gray" Margin="16,0,0,0" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Known Faces Section -->
            <GroupBox Grid.Row="0" Header="Known Faces" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Add New Face" />
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="200" Margin="0,0,8,0">
                                <TextBox x:Name="NewFaceNameBox"
                                         Text="{Binding NewFaceName, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center">
                                    <TextBox.ToolTip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="340">
                                            <Run FontWeight="SemiBold" Text="Поле для имени человека (необязательно)" />
                                            <LineBreak />
                                            <Run Text="Нажмите «Add Face» — откроется диалог выбора файлов, где нужно указать одно или несколько изображений, на которых видно лицо." />
                                            <LineBreak />
                                            <Run Text="Если имя в это поле не введено, после выбора файлов оно будет запрошено отдельным диалогом (со списком уже известных имён)." />
                                        </TextBlock>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Text="Например: Ivanov Ivan" Foreground="Gray"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewFaceNameBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="Add Face" Command="{Binding AddKnownFaceCommand}"
                                    Style="{StaticResource ActionBtn}" />
                            <Button Content="Clear All" Command="{Binding ClearAllCommand}"
                                    Style="{StaticResource ActionBtn}" />
                            <Button Content="Known Faces" Command="{Binding ShowKnownFacesCommand}"
                                    Style="{StaticResource ActionBtn}" />
                        </StackPanel>
                    </StackPanel>
                    <ListView ItemsSource="{Binding KnownFaces}" MaxHeight="150">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" Width="150"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ImagePath}" Foreground="Gray"
                                               FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <!-- Scan Section -->
            <GroupBox Grid.Row="1" Header="Scan Directory" Margin="0,0,0,12">
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding ScanDirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                                 Width="400" Margin="0,0,8,0"
                                 VerticalContentAlignment="Center" />
                        <Button Content="..." Command="{Binding BrowseDirectoryCommand}"
                                Style="{StaticResource ActionBtn}" MinWidth="40" Padding="8,8" />
                        <Button Content="Scan" Command="{Binding ScanDirectoryCommand}"
                                Style="{StaticResource ActionBtn}" />
                        <Button Content="Stop" Command="{Binding StopScanCommand}"
                                Style="{StaticResource ActionBtn}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Settings -->
            <GroupBox Grid.Row="2" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Models Directory" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ModelsDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Distance Threshold" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DistanceThreshold, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <TextBlock Text="Thread Count" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ThreadCount, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <TextBlock Text="3D Alignment" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AlignmentStatus}" Foreground="Gray" Margin="0,0,0,8" />
                        <Button Content="Download 3D Model" Command="{Binding DownloadModelCommand}"
                                Style="{StaticResource ActionBtn}" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
