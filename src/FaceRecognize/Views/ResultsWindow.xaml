<Window x:Class="FaceRecognize.Views.ResultsWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:FaceRecognize.Converters"
        mc:Ignorable="d"
        Title="Scan Results" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:ImagePathToBitmapConverter x:Key="ImgPath" />
        <converters:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmap" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Margin="16">
        <!-- Summary -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Scan Results" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Foreground="Gray" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Images scanned: " />
                    <Run Text="{Binding TotalImagesScanned, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  |  Faces found: " />
                    <Run Text="{Binding TotalFacesFound, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="Show:" VerticalAlignment="Center" Margin="16,0,4,0" />
                <ComboBox ItemsSource="{Binding AvailableDisplayModes}"
                          SelectedItem="{Binding SelectedDisplayMode}"
                          Width="120" />
            </StackPanel>
        </StackPanel>

        <!-- All results in one scroll -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Known Faces -->
                <GroupBox Header="Known Faces" Margin="0,0,0,12"
                          Visibility="{Binding IsKnownVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding KnownFaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="8" BorderBrush="LightGreen"
                                        BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="DarkGreen">
                                            <Run Text="{Binding PersonName, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Faces.Count, Mode=OneWay}" />
                                            <Run Text=" faces" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Faces}" Margin="8,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Left" Margin="0,0,8,4">
                                                        <Image Width="100" Height="100" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Source" Value="{Binding Thumbnail, Converter={StaticResource ByteArrayToBitmap}}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                            <Setter Property="Source" Value="{Binding ImagePath, Converter={StaticResource ImgPath}}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                            <Image.ToolTip>
                                                                <ToolTip>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding ImagePath}" TextWrapping="Wrap" MaxWidth="300" />
                                                                        <TextBlock>
                                                                            <Run Text="Confidence: " />
                                                                            <Run Text="{Binding Confidence, StringFormat={}{0:P1}}" FontWeight="SemiBold" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Image.ToolTip>
                                                            <Image.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding DataContext.OpenImageCommand, Source={x:Reference RootWindow}}"
                                                                              CommandParameter="{Binding ImagePath}" />
                                                            </Image.InputBindings>
                                                        </Image>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="Gray">
                                                            <Run Text="{Binding Confidence, StringFormat={}{0:P1}}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- Exclusion Panel -->
                <GroupBox Header="Exclude known people" Margin="0,0,0,12"
                          Visibility="{Binding IsExclusionPanelVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding KnownPeopleNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsExcluded, Mode=TwoWay}"
                                          Margin="0,0,16,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- Unknown Clusters -->
                <GroupBox Header="Unknown Face Clusters"
                          Visibility="{Binding IsUnknownVisible, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding UnknownClusters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="8" BorderBrush="LightGray"
                                        BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="Cluster #" />
                                            <Run Text="{Binding ClusterId, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding FaceCount, Mode=OneWay}" />
                                            <Run Text=" faces" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Faces}" Margin="8,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Width="128" Height="128" Stretch="UniformToFill"
                                                           Margin="0,0,4,4">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Source" Value="{Binding Thumbnail, Converter={StaticResource ByteArrayToBitmap}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                        <Setter Property="Source" Value="{Binding ImagePath, Converter={StaticResource ImgPath}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                        <Image.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock Text="{Binding ImagePath}" TextWrapping="Wrap" MaxWidth="300" />
                                                            </ToolTip>
                                                        </Image.ToolTip>
                                                        <Image.InputBindings>
                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                          Command="{Binding DataContext.OpenImageCommand, Source={x:Reference RootWindow}}"
                                                                          CommandParameter="{Binding ImagePath}" />
                                                        </Image.InputBindings>
                                                        <Image.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Add to known"
                                                                          Command="{Binding DataContext.AddToKnownCommand, Source={x:Reference RootWindow}}"
                                                                          CommandParameter="{Binding ImagePath}" />
                                                                <Separator />
                                                                <MenuItem Header="Show info"
                                                                          Command="{Binding DataContext.ShowInfoCommand, Source={x:Reference RootWindow}}"
                                                                          CommandParameter="{Binding ImagePath}" />
                                                            </ContextMenu>
                                                        </Image.ContextMenu>
                                                    </Image>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
