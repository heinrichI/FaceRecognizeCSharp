<Window x:Class="FaceRecognize.Views.KnownFacesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FaceRecognize.Converters"
        Title="Known Faces" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:ImagePathToBitmapConverter x:Key="ImgPath" />
        <converters:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmap" />
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock FontSize="18" FontWeight="Bold" Text="Known Faces" VerticalAlignment="Center" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Margin="16,0,0,0" Padding="12,4" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding People}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Descriptors" Binding="{Binding DescriptorCount}" Width="100" />
                <DataGridTemplateColumn Header="Faces" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Faces}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Width="80" Height="80" Stretch="UniformToFill" Margin="2"
                                               Source="{Binding Thumbnail, Converter={StaticResource ByteArrayToBitmap}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
